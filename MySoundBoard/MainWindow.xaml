<ui:FluentWindow x:Class="MySoundBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MySoundBoard" Height="680" Width="900"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{x:Static ApplicationCommands.New}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{x:Static ApplicationCommands.Open}"/>
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="NewMenuItem_Click"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveMenuItem_Click"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="AddSoundsMenuItem_Click"/>
    </ui:FluentWindow.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="Soundboard" Title="My Soundboard"/>

        <!-- Menu bar + Stop All button -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0">
                <ui:MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                    <ui:MenuItem Header="_New Board" InputGestureText="Ctrl+N" Icon="{ui:SymbolIcon Symbol=DocumentAdd24}" Click="NewMenuItem_Click"/>
                    <ui:MenuItem Header="_Save" InputGestureText="Ctrl+S" Icon="{ui:SymbolIcon Symbol=Save24}" Click="SaveMenuItem_Click"/>
                    <ui:MenuItem Header="_Load" x:Name="LoadMenuItem" Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"/>
                    <Separator/>
                    <ui:MenuItem Header="_Add Sounds…" InputGestureText="Ctrl+O" Icon="{ui:SymbolIcon Symbol=Add24}" Click="AddSoundsMenuItem_Click"/>
                    <Separator/>
                    <ui:MenuItem Header="_Delete Current Board…" x:Name="DeleteBoardMenuItem" Icon="{ui:SymbolIcon Symbol=Delete20}" Click="DeleteBoardMenuItem_Click"/>
                    <ui:MenuItem Header="Open Boards _Folder" Icon="{ui:SymbolIcon Symbol=FolderOpen24}" Click="OpenBoardsFolderMenuItem_Click"/>
                    <Separator/>
                    <ui:MenuItem Header="E_xit" Icon="{ui:SymbolIcon Symbol=ArrowExit20}" Click="ExitMenuItem_Click"/>
                </ui:MenuItem>
                <ui:MenuItem Header="_Tools" SubmenuOpened="ToolsMenu_SubmenuOpened">
                    <ui:MenuItem Header="Sort" Icon="{ui:SymbolIcon Symbol=ArrowSort24}" Click="SortMenuItem_Click"/>
                    <ui:MenuItem x:Name="StopAllHotkeyMenuItem" Header="Set Stop All _Hotkey…" Icon="{ui:SymbolIcon Symbol=Keyboard24}" Click="SetStopAllHotkeyMenuItem_Click"/>
                    <ui:MenuItem x:Name="ClearStopAllHotkeyMenuItem" Header="Clear Stop All Hotkey" Click="ClearStopAllHotkeyMenuItem_Click"/>
                    <Separator/>
                    <ui:MenuItem Header="_Theme" Icon="{ui:SymbolIcon Symbol=List24}">
                        <ui:MenuItem x:Name="DayMenuItem" Icon="{ui:SymbolIcon Symbol=WeatherSunny24}" Header="_Light" IsCheckable="True" Click="DayMenuItem_Click"/>
                        <ui:MenuItem x:Name="NightMenuItem" Icon="{ui:SymbolIcon Symbol=DarkTheme24}" Header="_Dark" IsCheckable="True" Click="NightMenuItem_Click"/>
                    </ui:MenuItem>
                </ui:MenuItem>
            </Menu>
            <ui:Button Grid.Column="2" x:Name="StopAllButton"
                       Content="Stop All" Appearance="Danger"
                       Icon="{ui:SymbolIcon Symbol=Stop24}"
                       Margin="4,2" Padding="8,4"
                       ToolTip="Stop all playing sounds (Escape)"
                       Click="StopAllButton_Click"/>
        </Grid>

        <!-- Board title -->
        <ui:TextBox Grid.Row="2" x:Name="SoundBoardTitle" FontSize="24" Text="My Soundboard"
                    Margin="8,4,8,0"
                    BorderThickness="0,0,0,1" Padding="2,4"/>

        <!-- Search / filter bar -->
        <ui:TextBox Grid.Row="3" x:Name="SearchBox"
                    Margin="8,4,8,4"
                    PlaceholderText="Search sounds…"
                    Icon="{ui:SymbolIcon Symbol=Search24}"
                    TextChanged="SearchBox_TextChanged"/>

        <!-- Sound button grid -->
        <!-- Transparent background so drops on empty space still hit the ScrollViewer -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent" AllowDrop="True" DragOver="Grid_DragOver" Drop="Grid_Drop">
            <ItemsControl x:Name="SoundBoardGrid" Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Global volume -->
        <Grid Grid.Row="5" Margin="8,4,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center"
                          Margin="0,0,8,0" FontSize="12" Opacity="0.65"/>
            <Slider x:Name="VolumeSlider" Grid.Column="1"
                    Maximum="100" Minimum="0"
                    TickPlacement="BottomRight" TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged"/>
            <ui:TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="100%"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          FontSize="12" TextAlignment="Right" Opacity="0.65"/>
        </Grid>

        <!-- Device selectors -->
        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Separator Grid.Row="0" Margin="8,4,8,0"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="8,4,8,8">
                    <ui:TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,3">Primary Output</ui:TextBlock>
                    <ComboBox x:Name="OutputDevice" DropDownOpened="DeviceCombo_DropDownOpened" ToolTip="Primary audio output — plays on your speakers or headset"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,4,8,8">
                    <ui:TextBlock FontSize="11" Opacity="0.65" Margin="0,0,0,3">Secondary Output (mic routing)</ui:TextBlock>
                    <ComboBox x:Name="HeadphoneDevice" DropDownOpened="DeviceCombo_DropDownOpened" ToolTip="Secondary output for mic routing (e.g. VB-Audio Cable Input)"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
